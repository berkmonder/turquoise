# Serves the built web app; paths that are not files get index.html (the app routes them itself).
# HTTPS, compression and the domain are the server's front Caddy's job.
:80 {
	root * /srv
	# Built files have a content hash in their name and never change: browsers keep them for a year.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
