# Serves the chat's files under /widget/ (berkmonder.com routes /widget/* here). HTTPS, compression and
# the domain are the server's front Caddy's job.
:80 {
	root * /srv
	# turquoise.js keeps its name (every page links to it): browsers check for a newer one each time.
	header /widget/turquoise.js Cache-Control "no-cache"
	# The chunks have a content hash in their name and never change: browsers keep them for a year.
	@chunks path_regexp ^/widget/.+-[A-Za-z0-9_-]{8}\.js$
	header @chunks Cache-Control "public, max-age=31536000, immutable"
	respond / "Turquoise's chat: /widget/turquoise.js (it runs on berkmonder.com)" 200
	file_server
}
