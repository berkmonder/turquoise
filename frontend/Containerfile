# Turquoise's chat as an image: built with Vite (React + TypeScript) into one script and its chunks,
# served by Caddy under /widget/. Its API is a separate image (backend/Containerfile).
FROM docker.io/library/node:22.23.2-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM docker.io/library/caddy:2.11.6-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
